# ES: Copia este archivo como .env y pon tu clave (NUNCA subas .env a git)
#     Cómo conseguirla: README.md → "Analizador de enlaces y Google Safe Browsing"
# EN: Copy this file as .env and add your key (NEVER commit .env to git)
#     How to get one: README.en.md → "Link checker and Google Safe Browsing"
SAFE_BROWSING_KEY=
PORT=3001

# ES: Secreto para firmar las cookies de sesión del login. Genera uno con:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EN: Secret used to sign the login session cookies. Generate one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
